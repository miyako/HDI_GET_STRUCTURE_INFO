{
	"destination": "detailScreen",
	"windowMinWidth": 1000,
	"windowMinHeight": 800,
	"width": 1200,
	"height": 820,
	"markerHeader": 15,
	"markerBody": 200,
	"markerBreak": 220,
	"markerFooter": 240,
	"events": [
		"onLoad",
		"onValidate",
		"onClick",
		"onOutsideCall",
		"onDoubleClick",
		"onDrop",
		"onMenuSelect",
		"onPluginArea",
		"onDataChange",
		"onDragOver",
		"onTimer",
		"onAfterKeystroke",
		"onAfterEdit",
		"onBeginDragOver",
		"onBoundVariableChange",
		"onPageChange"
	],
	"method": "method.4dm",
	"pageFormat": {
		"paperName": "A4",
		"paperWidth": "842pt",
		"paperHeight": "595pt"
	},
	"pages": [
		{
			"objects": {
				"TabControl": {
					"type": "tab",
					"top": 20,
					"left": 20,
					"width": 1160,
					"height": 780,
					"sizingX": "grow",
					"sizingY": "grow",
					"dataSource": "vTabControl",
					"dataSourceTypeHint": "arrayText",
					"labels": [
						"Info",
						"Tables",
						"Indexes",
						"Relations",
						"Extra"
					],
					"action": "gotoPage",
					"events": [
						"onClick"
					]
				}
			}
		},
		{
			"objects": {
				"Button": {
					"type": "button",
					"top": 178,
					"left": 772,
					"width": 280,
					"height": 22,
					"text": "XML structure",
					"focusable": false,
					"method": "ObjectMethods/Button.4dm",
					"events": [
						"onClick"
					]
				},
				"Button4": {
					"type": "button",
					"top": 254,
					"left": 772,
					"width": 280,
					"height": 21,
					"text": "Open \"getDatabaseStructure\" method",
					"focusable": false,
					"method": "ObjectMethods/Button4.4dm",
					"events": [
						"onClick"
					]
				},
				"Button1": {
					"type": "button",
					"top": 383,
					"left": 772,
					"width": 280,
					"height": 22,
					"text": "JSON structure",
					"focusable": false,
					"method": "ObjectMethods/Button1.4dm",
					"events": [
						"onClick"
					]
				},
				"Text": {
					"type": "text",
					"top": 93,
					"left": 40,
					"width": 1120,
					"height": 65,
					"fontWeight": "bold",
					"text": "You can retrieve the information on the database structure with the EXPORT STRUCTURE command. The whole database structure definition is exported in XML tree. \r\rIn this example:\r"
				},
				"Text23": {
					"type": "text",
					"top": 178,
					"left": 128,
					"width": 560,
					"height": 49,
					"fontWeight": "bold",
					"text": "We export the database structure in xml. Click on  \"XML structure\" button to see the xml tree. "
				},
				"Text24": {
					"type": "text",
					"top": 254,
					"left": 128,
					"width": 560,
					"height": 113,
					"fontWeight": "bold",
					"text": "We parse the xml tree to retrieve:\r   * the table and field information\r   * the index information\r   * the relation information. \rClick on  \"Open getDatabaseStructure method\" button to see the code. "
				},
				"Text25": {
					"type": "text",
					"top": 383,
					"left": 128,
					"width": 560,
					"height": 49,
					"fontWeight": "bold",
					"text": "We save the result in an object variable. Click on \"JSON structure\" button to see the exported object in JSON file."
				},
				"Text26": {
					"type": "text",
					"top": 469,
					"left": 128,
					"width": 560,
					"height": 97,
					"fontWeight": "bold",
					"text": "We display the content of object in the other tabs:\r   * Tables\r   * Indexes\r   * Relations"
				},
				"Picture1": {
					"type": "picture",
					"top": 181,
					"left": 88,
					"width": 20,
					"height": 20,
					"pictureFormat": "scaled",
					"picture": "/RESOURCES/1.png"
				},
				"Picture3": {
					"type": "picture",
					"top": 254,
					"left": 88,
					"width": 20,
					"height": 20,
					"pictureFormat": "scaled",
					"picture": "/RESOURCES/2.png"
				},
				"Picture4": {
					"type": "picture",
					"top": 383,
					"left": 88,
					"width": 20,
					"height": 20,
					"pictureFormat": "scaled",
					"picture": "/RESOURCES/3.png"
				},
				"Picture5": {
					"type": "picture",
					"top": 469,
					"left": 88,
					"width": 20,
					"height": 20,
					"pictureFormat": "scaled",
					"picture": "/RESOURCES/4.png"
				},
				"Picture6": {
					"type": "picture",
					"top": 577,
					"left": 88,
					"width": 20,
					"height": 20,
					"pictureFormat": "scaled",
					"picture": "/RESOURCES/5.png"
				},
				"Text27": {
					"type": "text",
					"top": 577,
					"left": 128,
					"width": 560,
					"height": 97,
					"fontWeight": "bold",
					"text": "In the last \"Extra\" tab, we provide you two 4D methods to replace the 4D Pack commands:\r   * _AP Get table info\r   * _AP Get field info"
				}
			}
		},
